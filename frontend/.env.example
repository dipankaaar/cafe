# ── Petuk Adda Cafe · Frontend env template ────────────────────────────
# Copy to `.env` (dev) / `.env.production` and adjust. Never commit real URLs
# with secrets. Consumed in frontend/src/services/api.js.

# Backend base URL *including* the /api prefix.
# Dev (Vite proxy also forwards /api → localhost:5000, so this may be left empty):
VITE_API_URL=http://localhost:5000/api

# Production example (same-origin when Express serves frontend/dist):
# VITE_API_URL=/api

# Production example (separate API host — must be allow-listed in backend CORS_ORIGIN):
# VITE_API_URL=https://api.petukaddacafe.com/api
