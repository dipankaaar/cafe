# ── Petuk Adda Cafe · Backend env template ─────────────────────────────
# Copy to `.env` and adjust per environment. Never commit `.env`.
# See backend/config/env.js for defaults and parsing rules.

# Server
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# CORS — '*' for local dev only. Production MUST be an explicit allow-list,
# e.g. CORS_ORIGIN=https://petukaddacafe.com,https://www.petukaddacafe.com
# ('*' cannot be combined with credentials; the server enforces this.)
CORS_ORIGIN=*

# SQLite database file (WAL mode). Use an absolute path in production.
DB_PATH=./data/cafe.db

# Auth — REQUIRED in production once JWT login is enabled.
# (Current login is staff-email lookup only; no password/JWT check yet.)
JWT_SECRET=change-me-to-a-long-random-string

# Tax & charges (percent). Mirrored in settings.taxRate / settings.serviceChargeRate.
TAX_RATE=5.0
SERVICE_CHARGE_RATE=0.0

# Rate limiting (sliding window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
