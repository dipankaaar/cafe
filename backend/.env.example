# Server Configuration
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# Optional CORS allowlist (comma-separated origins if frontend is hosted on another domain)
# CORS_ORIGIN=https://mycafe.vercel.app,https://mycafe-admin.vercel.app

# Database Path (default points to backend/data/cafe.db)
# DB_PATH=./data/cafe.db

# Security & Business Settings
JWT_SECRET=super-secret-production-key-change-this
TAX_RATE=5.0
SERVICE_CHARGE_RATE=0.0
